name: Rassegna stampa Foggia

on:
  schedule:
    - cron: "*/15 * * * *"   # ogni 15 minuti (orario UTC, GitHub può ritardare di qualche minuto)
  workflow_dispatch:          # pulsante "Run workflow" per avviarlo a mano

permissions:
  contents: write             # serve per salvare inviate.json

concurrency:
  group: rassegna
  cancel-in-progress: false

jobs:
  invia:
    runs-on: ubuntu-latest
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - run: pip install -r requirements.txt

      - name: Leggi i feed e invia su Telegram
        env:
          TELEGRAM_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python bot.py

      - name: Salva l'elenco delle notizie già inviate
        if: always()
        run: |
          git config user.name "rassegna-bot"
          git config user.email "rassegna-bot@users.noreply.github.com"
          git add inviate.json 2>/dev/null || true
          git diff --cached --quiet || git commit -m "Aggiorna notizie inviate"
          git push || (git pull --rebase && git push)
